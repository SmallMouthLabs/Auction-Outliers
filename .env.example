# ---------------------------------------------------------------------------
# OUTLIER configuration. Copy to .env (repo root). Secrets stay server-side.
# ---------------------------------------------------------------------------

# ---- AI providers (at least one is needed for live analysis; none needed for DEMO MODE) ----
# Claude (recommended for the deep stage; Haiku 5.5 is also a cheap triage option)
ANTHROPIC_API_KEY=
# Gemini (recommended for the low-cost triage stage: gemini-2.5-flash)
GEMINI_API_KEY=

# Stage routing: auto | anthropic | gemini | demo   (auto = gemini for triage if set, else anthropic; anthropic for deep if set, else gemini)
OUTLIER_TRIAGE_PROVIDER=auto
OUTLIER_TRIAGE_MODEL=
OUTLIER_DEEP_PROVIDER=auto
OUTLIER_DEEP_MODEL=

# Spending limits (estimated from token usage; the backend refuses calls beyond these)
OUTLIER_DAILY_BUDGET_USD=5.0
OUTLIER_PER_LISTING_BUDGET_USD=0.50
OUTLIER_MAX_ZOOM_CALLS=6
OUTLIER_MAX_IMAGES_PER_CALL=8

# ---- eBay (optional) ----
# Browse API (active listings only) works with any developer keyset.
# Marketplace Insights (SOLD data, 90-day) is limited release and needs eBay's approval for your keyset.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# ---- ShopGoodwill Personal Shopper e-mails via IMAP (optional; .eml upload works without this) ----
OUTLIER_IMAP_HOST=
OUTLIER_IMAP_PORT=993
OUTLIER_IMAP_USER=
OUTLIER_IMAP_PASSWORD=
OUTLIER_IMAP_FOLDER=INBOX
OUTLIER_IMAP_SUBJECT_FILTER=Personal Shopper

# ---- Unofficial ShopGoodwill buyer-API adapter (OFF by default; read docs/research.md first) ----
OUTLIER_ENABLE_UNOFFICIAL_SGW_API=false
OUTLIER_SGW_MIN_REQUEST_INTERVAL_SECONDS=5

# ---- Webhooks for n8n / automation (disabled until a token is set) ----
OUTLIER_WEBHOOK_TOKEN=

# ---- Server ----
OUTLIER_HOST=127.0.0.1
OUTLIER_PORT=8000
OUTLIER_RUN_WORKER=true
OUTLIER_LOG_LEVEL=INFO
# OUTLIER_DATA_DIR=./backend/data
# OUTLIER_DATABASE_URL=postgresql+psycopg://user:pass@localhost/outlier   # optional PostgreSQL

# ---- Buyer context ----
OUTLIER_BUYER_ZIP=
OUTLIER_BUYER_STATE_SALES_TAX_RATE=0

# ---- Frontend ----
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
